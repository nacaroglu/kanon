# Copy to .env and adjust. All variables use the KANON_ prefix.
KANON_DATABASE_URL=postgresql://kanon:kanon@localhost:5432/kanon
KANON_LOG_LEVEL=INFO
# Approved procedure repository (must exist if set). Create the sample with:
#   scripts/make-sample-repo.sh ./procedure-repo
KANON_PROCEDURE_REPO_PATH=./procedure-repo

# Docker Compose (read automatically from .env)
# Host directory mounted at /data/procedures in the backend container.
KANON_PROCEDURE_REPO_HOST_PATH=./procedure-repo
POSTGRES_USER=kanon
POSTGRES_PASSWORD=kanon
POSTGRES_DB=kanon
